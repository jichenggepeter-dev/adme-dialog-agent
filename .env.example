ADME_MOCK_MODE=true

# The conversational Agent is disabled unless explicitly enabled.
AGENT_ENABLED=false
# Live is the default. Mock requires an explicit versioned scenario per chat request.
AGENT_PROVIDER_MODE=live
# Configure an OpenAI-compatible Responses API only for enabled live mode.
# Never commit a real API key.
AGENT_LLM_BASE_URL=https://your-provider.example/v1
AGENT_LLM_API_KEY=replace-with-your-api-key
AGENT_LLM_MODEL=replace-with-your-model-id
AGENT_LLM_CONNECT_TIMEOUT_SECONDS=5
AGENT_LLM_READ_TIMEOUT_SECONDS=180
AGENT_LLM_TOTAL_TIMEOUT_SECONDS=240
# Disable hosted Agents SDK tracing. Local redacted audit logging remains enabled.
OPENAI_AGENTS_DISABLE_TRACING=1
AGENT_DB_PATH=data/agent.sqlite3
