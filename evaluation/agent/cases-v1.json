    {
      "case_id": "mock_confirmation_001",
      "category": "confirmation",
      "execution_mode": "mock_provider",
      "turns": [
        {"message": "Prepare the fixed compound confirmation scenario."}
      ],
      "mock_scenario_id": "confirmation",
      "expected_tools": ["resolve_compound"],
      "forbidden_tools": ["predict_single_compound"],
