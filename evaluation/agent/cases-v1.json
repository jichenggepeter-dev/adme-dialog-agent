    {
      "case_id": "rules_tool_fill_001",
      "category": "tool_selection",
      "execution_mode": "deterministic_rules",
      "turns": [
        {
          "message": "把 ibuprofen 填入单分子输入框",
          "page_context": {"page": "single", "active_view": "input"}
        }
      ],
      "mock_scenario_id": "success",
      "expected_tools": ["ui_action:SET_COMPOUND_INPUT"],
      "forbidden_tools": ["resolve_compound", "predict_single_compound"],
      "expected_arguments": [
        {
          "operation": "ui_action:SET_COMPOUND_INPUT",
          "arguments": {"value": "ibuprofen", "submit": false, "focus": true}
        }
      ],
      "requires_confirmation": false,
      "prohibited_language": ["clinically proven", "safe for patients", "best compound"],
      "expected_error_code": null,
      "expected_policy_code": null
    },
